DATABASE_URL=postgresql://buildsafe:buildsafe@127.0.0.1:5432/buildsafe
AUTH_SECRET=dev-only-secret-change-in-production-9f3b1c
AUTH_TRUST_HOST=true
# SMTP_HOST=            # unset → alert emails logged to email_log instead of sent
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=BuildSafe <alerts@yourdomain.com.au>
# STRIPE_SECRET_KEY=    # unset → subscription flow runs in demo mode
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_TRADIE=  # price id for Tradie Watch $29/mo
# STRIPE_PRICE_BUILDER= # price id for Builder Pro $99/mo
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# ABR_GUID=             # ABN Lookup web services GUID (register free at abr.business.gov.au)
# CRON_SECRET=          # random secret; Vercel sends it as Bearer auth to /api/cron/ingest (openssl rand -hex 32)
# INGEST_BATCH=25        # companies re-checked per scheduled ingest run (stalest first)

# ── SPEC_V2 photo pipeline + imports ──
# R1 photo pipeline (npm run photos:fetch — scripts/fetch-photos.ts). Set ONE (or both):
# UNSPLASH_ACCESS_KEY=  # Unsplash API access key — free signup: https://unsplash.com/developers (demo keys: 50 req/hr)
# PEXELS_API_KEY=       # Pexels API key — free signup: https://www.pexels.com/api/ (200 req/hr, 20k/month)
# R4 Google Business Profile import (Places API) — optional, UI degrades gracefully without it
# GOOGLE_MAPS_API_KEY=  # enable "Places API" + create a key at https://console.cloud.google.com/apis

# --- Security pass additions ---
# Rate limiting (optional). Without these, an in-memory sliding-window limiter is
# used — fine for local/single-instance, NOT safe across serverless replicas.
# Free tier: https://upstash.com  (create a Redis DB → REST URL + token)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional). Unset → Sentry is fully inert (no network calls).
# Free tier: https://sentry.io  (create a project → copy its DSN into both)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Seeding: set SEED_DEMO=1 to seed demo accounts (*@demo.buildsafe / demo1234).
# NEVER set this in production — prod seeds only the category taxonomy.
# Defaults ON automatically when NODE_ENV !== 'production'.
SEED_DEMO=
